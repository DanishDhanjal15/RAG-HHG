# --- Speech-to-text (required for voice input) ---
# Sarvam AI: https://dashboard.sarvam.ai  -> API Keys
VRAG_SARVAM_API_KEY=

# --- Optional: LLM polish path (off the critical path) ---
# Leave empty to run extractive-only. The <200ms core does not need this.
VRAG_ANTHROPIC_API_KEY=

# --- Optional: only needed if the dataset repo becomes gated ---
VRAG_HF_TOKEN=

# --- Runtime overrides (see configs/default.yaml for the full set) ---
# VRAG_CONFIG=configs/default.yaml
# VRAG_DATA_DIR=data
